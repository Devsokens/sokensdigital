// Firestore owns: profiles (identity/role for rule checks), chatRooms +
// messages, notifications, internalDocuments.
// Django + Supabase own: departments, projects, disbursementRequests,
// auditLogs — real relational data with business logic (partie double,
// workflow N1/N2/N3, budgets tied to Finance). Those collections do NOT
// exist here by design; querying them from the client would be a mistake,
// not a missing feature. See docs/backend-specifications.md.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helper Functions
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // TODO(chat): project membership lives in Django/Supabase, not
    // Firestore, so this can't `get()` a /projects/{id} doc here. Once
    // PROJECT-type chat rooms are built, Django needs to push a minimal
    // read-only mirror (e.g. chatRooms/{roomId}.memberUids) via the
    // Firebase Admin SDK it already has — client-side rules can only ever
    // read Firestore, never Postgres.

    // Profiles Rules
    match /profiles/{userUid} {
      // Any signed-in colleague can read any profile — this is basic
      // company-directory info (name/role/department), needed so the
      // messaging module can list colleagues to start a DM with. Nothing
      // more sensitive (salary, contracts...) lives on this doc; that stays
      // in Django/Supabase behind its own RBAC.
      allow read: if isAuth();
      // No client-side self-provisioning by design — accounts (Auth user +
      // this profile doc) are created by a Super-Admin/RH, either via the
      // Firebase Console directly or a future admin UI. See
      // docs/backend-specifications.md §3.1.
      allow create: if isAuth() && getUserData().role in ['SUPER_ADMIN', 'RESPONSABLE_RH'];
      allow delete: if isAuth() && getUserData().role in ['SUPER_ADMIN', 'RESPONSABLE_RH'];
      // Update: Super-Admin/RH can change anything (role, department...).
      // Anyone else may only touch their own doc, and only its
      // self-editable fields — role/departmentId/email/createdAt must be
      // left byte-for-byte identical, so a regular user can never
      // self-promote.
      allow update: if isAuth() && (
        getUserData().role in ['SUPER_ADMIN', 'RESPONSABLE_RH'] ||
        (
          request.auth.uid == userUid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.departmentId == resource.data.departmentId &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.createdAt == resource.data.createdAt
        )
      );
    }

    // ChatRooms & Nested Sub-Collections Rules
    match /chatRooms/{roomId} {
      // `resource == null` covers a get() on a room that doesn't exist yet —
      // getOrCreateDirectRoom() reads before writing to decide whether to
      // create a new DM, and without this branch `resource.data` on a null
      // resource throws inside the rule, which Firestore reports back to
      // the client as permission-denied instead of a clean "not found".
      allow read: if isAuth() && (
        resource == null ||
        resource.data.roomType == 'COMPANY' ||
        (resource.data.roomType == 'DEPARTMENT' && resource.data.departmentId == getUserData().departmentId) ||
        (resource.data.roomType == 'PROJECT' && request.auth.uid in resource.data.memberUids) ||
        (resource.data.roomType == 'DIRECT' && request.auth.uid in resource.data.memberUids)
      );
      // COMPANY/DEPARTMENT/PROJECT rooms are pushed by the Admin SDK
      // (bypasses rules entirely) — the only client-side creation path is a
      // user starting a 1:1 DIRECT conversation with themself as a member.
      allow create: if isAuth() && (
        getUserData().role == 'SUPER_ADMIN' ||
        (
          request.resource.data.roomType == 'DIRECT' &&
          request.auth.uid in request.resource.data.memberUids &&
          request.resource.data.memberUids.size() == 2
        )
      );
      allow update, delete: if isAuth() && getUserData().role == 'SUPER_ADMIN';

      match /messages/{messageId} {
        // Corrige F1 (pentest du 24/09/2026) : Firestore n'hérite JAMAIS une
        // règle d'un chemin parent vers une sous-collection — le commentaire
        // précédent ("validé automatiquement par le parent") était faux, et
        // `if isAuth()` laissait tout compte connecté lire collectionGroup
        // 'messages' en entier, tous départements et conversations privées
        // confondus. On reprend donc ici, explicitement, la même condition
        // par type de salon que pour la lecture du salon lui-même et pour
        // la création d'un message (juste en dessous).
        allow read: if isAuth() && (
          (
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'COMPANY'
          ) ||
          (
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'DEPARTMENT' &&
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.departmentId == getUserData().departmentId
          ) ||
          (
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'PROJECT' &&
            request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberUids
          ) ||
          (
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'DIRECT' &&
            request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberUids
          )
        );

        // Mirrors the room-level read rule exactly, per roomType — a plain
        // "not COMPANY" check let anyone who merely guessed a room id post
        // into a DEPARTMENT/PROJECT/DIRECT room they aren't a member of.
        // Corrige aussi F2 (pentest du 24/09/2026) : la vérification
        // d'appartenance ne suffisait pas seule — rien n'empêchait de
        // publier un message avec `authorUid` usurpé (un autre uid que
        // l'appelant), ce qui l'affiche comme venant de quelqu'un d'autre.
        allow create: if isAuth() &&
          request.resource.data.authorUid == request.auth.uid && (
          (
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'COMPANY' &&
            getUserData().role in ['SUPER_ADMIN', 'RESPONSABLE_MARKETING']
          ) ||
          (
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'DEPARTMENT' &&
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.departmentId == getUserData().departmentId
          ) ||
          (
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'PROJECT' &&
            request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberUids
          ) ||
          (
            get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'DIRECT' &&
            request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberUids
          )
        );

        // Message content (text/author/attachment/link/thread parent) is
        // immutable once created — an update may only ever touch the
        // reactions/pin fields, never rewrite what was said. Reacting/
        // pinning is restricted to the same membership check as create.
        // `pinnedBy`, quand renseigné, doit être l'appelant lui-même —
        // sinon n'importe quel membre du salon pouvait épingler un message
        // au nom d'un collègue (constat mineur du pentest du 24/09/2026).
        allow update: if isAuth() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinned', 'pinnedBy', 'pinnedAt']) &&
          (!('pinnedBy' in request.resource.data) || request.resource.data.pinnedBy == null || request.resource.data.pinnedBy == request.auth.uid) && (
            (
              get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'COMPANY' &&
              getUserData().role in ['SUPER_ADMIN', 'RESPONSABLE_MARKETING']
            ) ||
            (
              get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'DEPARTMENT' &&
              get(/databases/$(database)/documents/chatRooms/$(roomId)).data.departmentId == getUserData().departmentId
            ) ||
            (
              get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'PROJECT' &&
              request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberUids
            ) ||
            (
              get(/databases/$(database)/documents/chatRooms/$(roomId)).data.roomType == 'DIRECT' &&
              request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberUids
            )
          );
        allow delete: if false;
      }
    }

    // Internal Documents Rules
    match /internalDocuments/{documentId} {
      allow read: if isAuth() && (
        resource.data.visibilityLevel == 'COMPANY' ||
        resource.data.authorId == request.auth.uid ||
        (resource.data.visibilityLevel == 'DEPARTMENT' && resource.data.authorDepartmentId == getUserData().departmentId)
      );
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      // Corrige F3 (pentest du 24/09/2026) : `update` ne regardait que la
      // NOUVELLE valeur d'authorId, jamais l'actuelle — n'importe quel
      // employé connaissant l'id d'un document (même sans droit de le lire)
      // pouvait l'écraser en se déclarant auteur, puis le supprimer grâce à
      // la règle `delete` ci-dessous. Il faut désormais déjà être l'auteur
      // pour modifier, ET rester l'auteur après la modification.
      allow update: if isAuth() &&
        resource.data.authorId == request.auth.uid &&
        request.resource.data.authorId == resource.data.authorId;
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;
    }

    // Notifications Rules (Strictement Isolation Client)
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.recipientId == request.auth.uid;
      // `update` restreint aux champs de lecture — sans ça (constat mineur
      // du pentest du 24/09/2026), le destinataire pouvait réécrire le
      // texte/lien de sa propre notification, ou changer `recipientId` pour
      // la faire apparaître dans la boîte de quelqu'un d'autre.
      allow update: if isAuth() && resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false; // Création déléguée aux scripts applicatifs (aucune Cloud Function en free tier — voir §0)
    }

    // Audit trail for Django-managed entities lives in Postgres
    // (core.AuditLog, immutable by construction — see LoggedModel). Only
    // Firestore-native writes (chat, notifications...) would ever need an
    // equivalent here, and none do yet.
  }
}
