# Copiez ce fichier vers .env pour l'environnement local
# cp .env.dev .env

# Database
POSTGRES_DB=sokens_db
POSTGRES_USER=sokens_user
POSTGRES_PASSWORD=sokens_password_dev

# Backend
# Local dev only — points at the docker-compose `db` (postgres:16-alpine)
# container. In production (Render), DATABASE_URL is set by hand in the
# Render dashboard to the Supabase connection string ("Connection pooling"
# mode) instead — Render's own free Postgres is deleted after 30+14 days,
# Supabase's free tier only pauses (data safe) after 7 days of inactivity.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# Local dev only too — docker-compose `redis` container. In production,
# REDIS_URL is set by hand in Render to the Upstash connection string
# (rediss://, TLS) instead — not Render's own Key Value (no disk
# persistence, can be wiped for maintenance at any time) and not Firebase
# (no Redis product at all; Google's only Redis, Memorystore, is a separate
# paid GCP service with no free tier).
REDIS_URL=redis://redis:6379/0
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string-in-every-real-environment
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of frontend origins allowed to call the API when
# DEBUG=False (in DEBUG mode every origin is allowed automatically).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin SDK (server-side). Use ONE of the two:
# - FIREBASE_SERVICE_ACCOUNT_JSON: the service account JSON as one line
#   (what you set on Render, since there's no filesystem to mount into).
# - GOOGLE_APPLICATION_CREDENTIALS: path to the service account JSON file
#   (convenient locally / in Docker).
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Webhook signature électronique (administration.SignatureWebhookView) —
# doit correspondre au secret configuré côté prestataire de signature.
# Sans cette variable, le webhook refuse tout callback (503) plutôt que
# d'accepter des requêtes non authentifiées.
SIGNATURE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Envoi d'e-mails
# ---------------------------------------------------------------------------
# Trois voies possibles, essayées dans cet ordre par settings.py :
#
#   1. API Gmail (GMAIL_* plus bas) — HTTPS, fonctionne partout.
#   2. SMTP (EMAIL_HOST ci-dessous).
#   3. Console : l'e-mail s'affiche dans les logs, rien ne part. C'est le
#      comportement par défaut en dev, et rien ne plante.
#
# --- Voie SMTP (mot de passe d'application Gmail) --------------------------
# Un mot de passe d'application Google (16 caractères, généré depuis
# https://myaccount.google.com/apppasswords) s'utilise ICI, dans
# EMAIL_HOST_PASSWORD — pas dans les variables GMAIL_* plus bas, qui
# attendent un jeton OAuth, ce qui n'est pas la même chose.
#
# Écrire les 16 caractères sans les espaces que Google affiche.
#
# ATTENTION — Render bloque les ports SMTP sortants (25/465/587) sur son
# offre gratuite, et render.yaml déclare `plan: free`. Cette configuration
# fonctionnera en local et échouera en production tant que le service reste
# sur ce plan. Voir docs/NOTIFICATIONS_ET_EMAILS.md.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=supportsokensdigital@gmail.com
EMAIL_HOST_PASSWORD=

# Gmail réécrit l'expéditeur avec le compte authentifié : annoncer une autre
# adresse ne sert à rien, autant déclarer la vraie.
DEFAULT_FROM_EMAIL=supportsokensdigital@gmail.com

# --- Voie API Gmail (OAuth) ------------------------------------------------
# Prioritaire sur SMTP dès que GMAIL_CLIENT_ID et GMAIL_REFRESH_TOKEN sont
# renseignés. Passe en HTTPS, donc fonctionne là où les ports SMTP sont
# fermés — notamment sur l'offre gratuite de Render.
#
# CLIENT_ID / CLIENT_SECRET viennent d'un client OAuth de type « Desktop app »
# dans Google Cloud ; le REFRESH_TOKEN s'obtient une seule fois avec
# scripts/generate_gmail_refresh_token.py. Ce n'est PAS un mot de passe
# d'application.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=supportsokensdigital@gmail.com

# Base des liens envoyés par e-mail (suivi de demande, validation de devis).
# Sans elle, ces e-mails contiendraient des liens inutilisables.
PUBLIC_SITE_URL=https://sokensdigital.com

# Clé publique Web Push du projet Firebase (Console → Paramètres du projet →
# Cloud Messaging → Certificats push web). Sans elle, l'activation des
# notifications navigateur se déclare indisponible, sans rien casser.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Rate limiting API (DRF throttling) — valeurs par défaut raisonnables,
# à ajuster selon le trafic réel observé en prod.
THROTTLE_RATE_ANON=100/hour
THROTTLE_RATE_USER=2000/hour
THROTTLE_RATE_PUBLIC_WRITE=10/hour
THROTTLE_RATE_WEBHOOK=60/min

# Facebook Page publishing (marketing/publishing.py) — blanc par défaut,
# rien ne se publie tant que les deux ne sont pas renseignés.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Firebase Frontend
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
